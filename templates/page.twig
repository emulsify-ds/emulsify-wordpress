{# Page fallback rendered by page.php. Child themes should extend or override
   this file instead of copying PHP route controllers. #}
{% extends '@templates/layouts/base.twig' %}

{% set entry_attributes = {
    class: bem('entry', [post.type|default('page')]),
    id: post.id|default(null) ? 'post-' ~ post.id : null
} %}
{% set entry_header_attributes = {
    class: bem('header', [], 'entry')
} %}
{% set entry_title_attributes = {
    class: bem('title', [], 'entry')
} %}
{% set entry_content_attributes = {
    class: bem('content', [], 'entry')
} %}

{% block content %}
    {% if post|default(null) %}
        <article {{ add_attributes(entry_attributes) }}>
            <header {{ add_attributes(entry_header_attributes) }}>
                <h1 {{ add_attributes(entry_title_attributes) }}>{{ post.title|wp_kses_post }}</h1>
            </header>

            <div {{ add_attributes(entry_content_attributes) }}>
                {{ post.content|raw }}
            </div>
        </article>
    {% else %}
        <p>{{ function('__', 'No page content was found.', 'emulsify') }}</p>
    {% endif %}
{% endblock %}
