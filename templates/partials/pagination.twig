{# Timber pagination fallback. Route templates pass a pagination object created
   from posts.pagination(). #}
{% set pages = pagination.pages|default([]) %}
{% set pagination_attributes = {
    class: bem('pagination'),
    'aria-label': function('__', 'Pagination', 'emulsify')
} %}
{% set pagination_items_attributes = {
    class: bem('items', [], 'pagination')
} %}
{% if pages is not empty %}
    <nav {{ add_attributes(pagination_attributes) }}>
        <ul {{ add_attributes(pagination_items_attributes) }}>
            {% if pagination.prev|default(null) %}
                {% set previous_item_attributes = {
                    class: bem('item', ['previous'], 'pagination')
                } %}
                {% set previous_link_attributes = {
                    class: bem('link', [], 'pagination'),
                    href: function('html_entity_decode', pagination.prev.link)
                } %}
                <li {{ add_attributes(previous_item_attributes) }}>
                    <a {{ add_attributes(previous_link_attributes) }}>{{ function('__', 'Previous', 'emulsify') }}</a>
                </li>
            {% endif %}

            {% for page in pages %}
                {% set page_item_attributes = {
                    class: bem('item', [page.current|default(false) ? 'current' : ''], 'pagination')
                } %}
                {% set page_link_attributes = {
                    class: [
                        bem('link', [], 'pagination'),
                        page.class|default('')
                    ],
                    href: page.link|default(null) ? function('html_entity_decode', page.link) : null,
                    'aria-current': page.current|default(false) ? 'page' : null
                } %}
                <li {{ add_attributes(page_item_attributes) }}>
                    {% if page.link|default(null) %}
                        <a {{ add_attributes(page_link_attributes) }}><span {{ add_attributes({ class: 'screen-reader-text' }) }}>{{ function('__', 'Page', 'emulsify') }} </span>{{ page.title }}</a>
                    {% else %}
                        <span {{ add_attributes(page_link_attributes) }}>{{ page.class|default('') == 'dots' ? function('__', '…', 'emulsify') : page.title }}</span>
                    {% endif %}
                </li>
            {% endfor %}

            {% if pagination.next|default(null) %}
                {% set next_item_attributes = {
                    class: bem('item', ['next'], 'pagination')
                } %}
                {% set next_link_attributes = {
                    class: bem('link', [], 'pagination'),
                    href: function('html_entity_decode', pagination.next.link)
                } %}
                <li {{ add_attributes(next_item_attributes) }}>
                    <a {{ add_attributes(next_link_attributes) }}>{{ function('__', 'Next', 'emulsify') }}</a>
                </li>
            {% endif %}
        </ul>
    </nav>
{% endif %}
