{# Standalone iframe srcdoc; see docs/media-embeds.md before overriding. #}
<!doctype html>
<html lang="{{ media_embed.language_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ media_embed.title ?: media_embed.play_label }}</title>
  <style>
    html, body { width: 100%; height: 100%; margin: 0; }
    .emulsify-oembed-poster { position: relative; display: grid; box-sizing: border-box; align-content: center; justify-items: center; gap: .75rem; width: 100%; height: 100%; overflow: hidden; background: #171b24; color: #fff; font-family: system-ui, sans-serif; text-decoration: none; }
    .emulsify-oembed-poster__thumbnail { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .emulsify-oembed-poster__play, .emulsify-oembed-poster__label { position: relative; border: 1px solid #fff; background: #111; color: #fff; }
    .emulsify-oembed-poster__play { display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; }
    .emulsify-oembed-poster__play svg { width: 2rem; height: 2rem; fill: currentColor; }
    .emulsify-oembed-poster__label { border-radius: .25rem; padding: .5rem 1rem; font-size: 1rem; font-weight: 600; }
    .emulsify-oembed-poster:focus-visible::after { position: absolute; inset: 0; outline: 3px solid #fff; outline-offset: -6px; box-shadow: inset 0 0 0 3px #111, inset 0 0 0 9px #111; content: ''; pointer-events: none; }
    .emulsify-oembed-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    @media (max-height: 160px) {
      .emulsify-oembed-poster { gap: .375rem; }
      .emulsify-oembed-poster__play { width: 3rem; height: 3rem; }
      .emulsify-oembed-poster__play svg { width: 1.5rem; height: 1.5rem; }
      .emulsify-oembed-poster__label { padding: .25rem .75rem; font-size: .875rem; line-height: 1.25; }
    }
    @media (forced-colors: active) {
      .emulsify-oembed-poster__thumbnail { display: none; }
      .emulsify-oembed-poster, .emulsify-oembed-poster__play, .emulsify-oembed-poster__label { border-color: CanvasText; background: Canvas; color: CanvasText; }
      .emulsify-oembed-poster:focus-visible::after { outline-color: Highlight; box-shadow: none; }
    }
  </style>
</head>
<body>
  <a {{ add_attributes({ class: 'emulsify-oembed-poster' }) }} href="{{ media_embed.player_url }}" target="_self" referrerpolicy="strict-origin-when-cross-origin">
    {% if media_embed.thumbnail_url %}<img {{ add_attributes({ class: 'emulsify-oembed-poster__thumbnail' }) }} src="{{ media_embed.thumbnail_url }}" alt="" referrerpolicy="no-referrer">{% endif %}
    <span {{ add_attributes({ class: 'emulsify-oembed-poster__play' }) }} aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><path d="M18 12v24l20-12z" fill="currentColor" /></svg></span>
    <span {{ add_attributes({ class: 'emulsify-oembed-poster__label' }) }}>{{ media_embed.play_label }}{% if media_embed.title %}<span {{ add_attributes({ class: 'emulsify-oembed-visually-hidden' }) }}>: {{ media_embed.title }}</span>{% endif %}</span>
  </a>
</body>
</html>
