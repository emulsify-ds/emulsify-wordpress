{# Shared page/post password fallback. Core supplies the form, including its
   site URL, accessible fields, redirect and the_password_form filter. #}
{% extends '@templates/layouts/base.twig' %}

{% if post|default(null) %}
    {% set title = function('get_the_title', post.id) %}
{% endif %}

{% block content %}
    {% if post|default(null) %}
        {{ function('get_the_password_form', post.id)|raw }}
    {% else %}
        <p>{{ function('__', 'This content is password protected.', 'emulsify') }}</p>
    {% endif %}
{% endblock %}
